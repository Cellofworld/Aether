# Database Configuration
DATABASE_URL=postgresql://aether:aether_password@postgres:5432/aether_db?schema=public

# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-1234567890

# TMDB API Key (optional, get from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Media Configuration
MEDIA_ROOT=/media
TRANSCODE_ROOT=/transcode

# Application Settings
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=*

# Scanner Settings
SCAN_ON_STARTUP=true
SCAN_INTERVAL=3600

# Transcoding Settings
TRANSCODING_ENABLED=true
HARDWARE_ACCELERATION=none
# Options: none, nvidia, vaapi, qsv

# Aether Media Server - Environment Variables
# Скопируйте этот файл в .env и заполните значения

# --- Project Settings ---
PROJECT_NAME=Aether Media Server
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Формат: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://aether:aether_password@postgres:5432/aether_db

# --- Redis (для кэша и очередей) ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Сгенерируйте случайную строку для продакшена: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Media Storage ---
# Путь к медиафайлам внутри контейнера
MEDIA_ROOT=/media
# Путь для временных файлов транскодинга
TRANSCODE_ROOT=/transcode
# Путь для кэша изображений
IMAGE_CACHE_DIR=/app/cache/images

# --- TMDB API ---
# Получите ключ на https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# --- Transcoding ---
# Включить транскодинг (true/false)
TRANSCODING_ENABLED=true
# Аппаратное ускорение: none, nvidia, vaapi, qsv
HARDWARE_ACCELERATION=none
# Битрейт для транскодинга (bps)
TRANSCODE_BITRATE=4000000
# Размер сегмента HLS (секунды)
HLS_SEGMENT_DURATION=4

# --- Scanner ---
# Сканировать при запуске (true/false)
SCAN_ON_STARTUP=true
# Интервал автоматического сканирования (минуты), 0 = отключено
SCAN_INTERVAL=0

# --- CORS ---
# Разрешенные.origin для frontend (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.1.100:5173,http://192.168.1.100

# --- Server ---
HOST=0.0.0.0
PORT=8000
